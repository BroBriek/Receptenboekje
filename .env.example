# Server
PORT=3001
NODE_ENV=development

# Paths (relative to project root; Docker overrides these via env)
DB_PATH=./data/receptenboekje.db
# UPLOADS_PATH is not set here — code defaults to <project_root>/uploads via __dirname.
# Docker sets UPLOADS_PATH=/app/uploads via Dockerfile ENV.

# Security
SESSION_SECRET=change-me-in-production

# Iframe embedding (e.g. Home Assistant)
# Leave empty to allow embedding from any site, or list allowed origins separated by spaces:
# FRAME_ANCESTORS="self http://homeassistant.local:8123 https://*.ui.nabu.casa"
FRAME_ANCESTORS=
